{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/jev-klondike/replay.schema.json",
  "title": "Jev Klondike Replay",
  "type": "object",
  "required": ["schema_version", "game", "run", "frames"],
  "properties": {
    "schema_version": { "const": 1 },
    "created_at_utc": { "type": "string" },
    "game": {
      "type": "object",
      "required": ["name", "variant", "stock_recycles", "tableau_flip"],
      "properties": {
        "name": { "const": "Klondike Solitaire" },
        "variant": { "const": "Draw-1" },
        "stock_recycles": { "const": "unlimited" },
        "tableau_flip": { "const": "automatic" }
      }
    },
    "run": {
      "type": "object",
      "required": ["seed", "agent", "win", "steps", "stop_reason"],
      "properties": {
        "seed": { "type": "integer" },
        "agent": { "type": "string" },
        "win": { "type": "boolean" },
        "steps": { "type": "integer", "minimum": 0 },
        "stop_reason": { "type": "string" }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/frame" }
    }
  },
  "$defs": {
    "card": {
      "type": "string",
      "pattern": "^(XX|-|(?:A|[2-9]|10|J|Q|K)[SHDC])$"
    },
    "visibleState": {
      "type": "object",
      "required": ["foundation", "tableau", "waste", "stock_count"],
      "properties": {
        "foundation": {
          "type": "object",
          "required": ["S", "H", "D", "C"],
          "properties": {
            "S": { "$ref": "#/$defs/card" },
            "H": { "$ref": "#/$defs/card" },
            "D": { "$ref": "#/$defs/card" },
            "C": { "$ref": "#/$defs/card" }
          }
        },
        "tableau": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "type": "array", "items": { "$ref": "#/$defs/card" } }
        },
        "waste": { "$ref": "#/$defs/card" },
        "stock_count": { "type": "integer", "minimum": 0, "maximum": 24 }
      }
    },
    "frame": {
      "type": "object",
      "required": ["step", "state", "action", "confidence", "probabilities", "legal_actions", "events"],
      "properties": {
        "step": { "type": "integer", "minimum": 0 },
        "state": { "$ref": "#/$defs/visibleState" },
        "action": { "type": ["string", "null"] },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "probabilities": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "legal_actions": { "type": "array", "items": { "type": "string" } },
        "events": {
          "type": "object",
          "required": ["hidden_revealed", "foundation_delta"],
          "properties": {
            "hidden_revealed": { "type": "integer", "minimum": 0 },
            "foundation_delta": { "type": "integer" }
          }
        }
      }
    }
  }
}
